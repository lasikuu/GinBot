# Copy to .env in the repository root. Every variable below is read only in
# internal/config; nothing else calls os.Getenv.
#
# This file targets local dev (docker-compose.dev.yml). docker-compose.prod.yml
# sets the fixed GINBOT_* host/db wiring itself and interpolates the rest of
# this file from the environment, so one .env serves both. The only variable it
# refuses to start without is GINBOT_DB_PASSWORD.
#
# Prod only: which optional clients to start (comma-separated Compose profiles).
# psql + ginbot-server always run; leave empty for server-only.
#   COMPOSE_PROFILES=discord         # + Discord client
#   COMPOSE_PROFILES=discord,matrix  # + both clients
COMPOSE_PROFILES=

# production, or anything else for development. Development additionally enables
# gRPC server reflection.
GINBOT_ENV=development
# debug | warn | error, anything else means info.
GINBOT_LOG_LEVEL=debug
# The bot's own public web address, if it has one. Its host is excluded from
# repost indexing, so linking the bot never counts as a repost. A bare host
# works too; the scheme, port and path are ignored.
#
# The exclusion covers SUBDOMAINS as well, exactly like
# GINBOT_REPOST_EXCLUDED_HOSTS. Set this to the bot's own host and nothing
# broader: "example.com" here silently stops repost detection for every link
# anywhere under *.example.com.
GINBOT_WEB_URL=

# --- gRPC ---
GINBOT_GRPC_HOST=localhost
GINBOT_GRPC_PORT=50051
# true switches the server and both clients to mutual TLS.
GINBOT_GRPC_TLS=false
# Directory holding ca-cert.pem and the server/client key pairs.
# Relative paths resolve against the working directory. Defaults to cert.
GINBOT_CERTS_PATH=cert

# --- Database ---
# Matches docker-compose.dev.yml. In production this same variable is also what
# the psql service's POSTGRES_PASSWORD is set from, so the secret has one name.
GINBOT_DB_HOST=localhost
GINBOT_DB_PORT=5432
GINBOT_DB_NAME=ginbot
GINBOT_DB_USERNAME=ginbot
GINBOT_DB_PASSWORD=gin123
# false skips goose.Up at server boot.
GINBOT_DB_MIGRATIONS=true

# --- Storage ---
# Where the server writes trigger media. It fetches and stores the bytes itself
# while the row pointing at them lives in Postgres, so this directory is
# persistent state: losing it leaves file rows referencing blobs that are gone.
# Relative paths resolve against the working directory.
GINBOT_STORAGE_PATH=./storage

# --- Repost detection ---
# Off by default, and read by BOTH binaries: the server fingerprints, and the
# Discord client requests the privileged MESSAGE_CONTENT intent when this is on.
GINBOT_REPOST=false
# Hosts never indexed, matched inclusive of subdomains. Comma separated.
GINBOT_REPOST_EXCLUDED_HOSTS=
# Absolute path to ffmpeg, needed only for video and animated GIF. Empty looks
# "ffmpeg" up on PATH; finding none degrades those formats to exact-hash-only
# rather than failing. The published container images do not carry one.
GINBOT_REPOST_FFMPEG_PATH=
# Tuning knobs, all optional. Inclusive Hamming distance bounds for the three
# confidence tiers. All three are clamped into [0, repost.MaxDistance] and then
# forced monotonic, so a nonsensical set is corrected with a warning rather than
# refused: a probable bound above MaxDistance would break the pigeonhole recall
# guarantee the index depends on.
GINBOT_REPOST_TIER_IDENTICAL=0
GINBOT_REPOST_TIER_HIGH=3
GINBOT_REPOST_TIER_PROBABLE=7
# Decoded images below either dimension, or below the Shannon entropy floor in
# bits (0..8), are not perceptually matched — small or near-flat images collide
# with each other rather than identifying anything.
GINBOT_REPOST_MIN_WIDTH=128
GINBOT_REPOST_MIN_HEIGHT=128
GINBOT_REPOST_MIN_ENTROPY=3.0

# --- Discord ---
DISCORD_OWNER_ID=
# Do NOT prefix with "Bot "; config adds it.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Comma separated. Empty disables chat commands; slash commands are unaffected.
DISCORD_COMMAND_PREFIXES=
# true deletes the registered application commands on shutdown.
DISCORD_REMOVE_COMMANDS=false
# Requests the privileged MESSAGE_CONTENT intent, which trigger matching needs.
# Only necessary on its own: a non-empty DISCORD_COMMAND_PREFIXES or
# GINBOT_REPOST=true already requests the intent. It must be enabled in the
# Discord developer portal first — asking for it before then closes the gateway
# with error 4014, which is why it stays opt-in.
DISCORD_MESSAGE_CONTENT=false

# --- Matrix ---
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=
