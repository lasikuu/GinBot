# Copy to .env in the repository root. Every variable below is read only in
# internal/config; nothing else calls os.Getenv.

# production, or anything else for development. Development additionally enables
# gRPC server reflection.
GINBOT_ENV=development
# debug | warn | error, anything else means info.
GINBOT_LOG_LEVEL=debug
# The bot's own public web address, if it has one. Its host is excluded from
# repost indexing, so linking the bot never counts as a repost. A bare host
# works too; the scheme, port and path are ignored.
#
# The exclusion covers SUBDOMAINS as well, exactly like
# GINBOT_REPOST_EXCLUDED_HOSTS. Set this to the bot's own host and nothing
# broader: "example.com" here silently stops repost detection for every link
# anywhere under *.example.com.
GINBOT_WEB_URL=

# --- gRPC ---
GINBOT_GRPC_HOST=localhost
GINBOT_GRPC_PORT=50051
# true switches the server and both clients to mutual TLS.
GINBOT_GRPC_TLS=false
# Directory holding ca-cert.pem and the server/client key pairs.
# Relative paths resolve against the working directory. Defaults to cert.
GINBOT_CERTS_PATH=cert

# --- Database ---
# Matches docker-compose.psql.yml.
GINBOT_DB_HOST=localhost
GINBOT_DB_PORT=5432
GINBOT_DB_NAME=ginbot
GINBOT_DB_USERNAME=ginbot
GINBOT_DB_PASSWORD=gin123
# false skips goose.Up at server boot.
GINBOT_DB_MIGRATIONS=true

# --- Discord ---
DISCORD_OWNER_ID=
# Do NOT prefix with "Bot "; config adds it.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Comma separated.
DISCORD_COMMAND_PREFIXES=
# true deletes the registered application commands on shutdown.
DISCORD_REMOVE_COMMANDS=false

# --- Matrix ---
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=
